{
  "name": "aida-site",
  "private": true,
  "version": "0.1.0",
  "description": "AIDA（AI DefTech Accelerator）官網：純 HTML + Tailwind CSS v4 靜態網站",
  "type": "module",
  "scripts": {
    "build": "npm run build:pages && npm run build:css",
    "build:pages": "node scripts/build-pages.mjs",
    "build:css": "tailwindcss -i src/styles/main.css -o dist/assets/css/main.css --minify",
    "dev:pages": "node scripts/build-pages.mjs --watch",
    "dev:css": "tailwindcss -i src/styles/main.css -o dist/assets/css/main.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.14",
    "tailwindcss": "4.1.14"
  }
}
